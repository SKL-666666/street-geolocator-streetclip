# ============================================================
# Street Geolocator 配置示例
# 复制为 backend/.env（开发）或直接传给 docker compose（生产）
# ============================================================

# ---- 服务 ----
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# ---- LLM 供应商 ----
# 可选：mock | openai | anthropic | gemini
# 其他 OpenAI 兼容服务（DeepSeek / 通义 / 智谱 / 豆包 / Moonshot 等）：
#   用 provider=openai + LLM_BASE_URL 指向各家端点
LLM_PROVIDER=mock
LLM_API_KEY=
# 例：DeepSeek -> https://api.deepseek.com/v1
#     通义千问(DashScope兼容模式) -> https://dashscope.aliyuncs.com/compatible-mode/v1
#     智谱GLM -> https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=
# 例：gpt-4o-mini / deepseek-chat / qwen-vl-max / glm-4v-plus / glm-4.6v / claude-sonnet-4 / gemini-2.0-flash
LLM_MODEL=
# 推理模型关闭思考链（速度优先：实测 40s → 数秒）
# LLM_DISABLE_THINKING=true
# 两级模型策略：主模型超时自动降级到快速模型（硬性 <15s 保证）
# LLM_PRIMARY_TIMEOUT_SEC=10
# LLM_FALLBACK_MODEL=glm-4v-flash
# LLM_TIMEOUT_SEC=90
# LLM_RETRIES=1

# ---- 街景数据源（可选，留空则跳过街景回查）----
# Mapillary ML Token：https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=
# MAPILLARY_RADIUS_M=60

# ---- 增强方案 ----
# 方案 B：地理事实知识库（默认开启，零外部依赖）
# ENABLE_GEOKB=true
# 方案 D：外部工具查证（地理编码/百科/时区，默认开启）
# ENABLE_TOOLS=true
# 地理编码端点（默认 Nominatim；国内网络可换可达实例，如自建 Nominatim）
# GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# 百科端点（留空用 https://{lang}.wikipedia.org；国内网络可配镜像）
# WIKI_BASE_URL=

# ---- 地图源（华为地图）----
# 华为 AppGallery Connect 地图 Key（https://developer.huawei.com/consumer/cn/map/）
# 留空则前端回退高德瓦片（免 key）
MAP_API_KEY=
# 华为瓦片 URL 模板（含 {x}{y}{z}{key} 占位；一般无需改动）
# MAP_TILE_URL=https://mapapi.cloud.huawei.com/mapapi/tile/v1/?x={x}&y={y}&z={z}&lang=zh&size=1&scale=1&apikey={key}

# ---- 分析模式 ----
# fast（快速）/ balanced（平衡，默认）/ deep（深度），可被上传时选择的模式覆盖
# ANALYZE_MODE=balanced

# ---- 缓存（已移除命中机制：每次上传都重新分析）----
# CACHE_ENABLED=false

# ---- 图像预处理 ----
# MAX_IMAGE_SIDE=2048
# JPEG_QUALITY=88

# ---- 存储 ----
# MAX_UPLOAD_MB=20
